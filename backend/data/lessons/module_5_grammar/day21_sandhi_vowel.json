{
  "id": "day21_sandhi_vowel",
  "title": "🔊 Vowel Sandhi (स्वरसन्धिः)",
  "description": "Learn how vowels combine when words meet in Sanskrit.",
  "level": "intermediate",
  "module": "grammar",
  "difficulty": 4,
  "prerequisites": ["day20_compound_verbs"],
  "estimated_time": 30,
  "sections": [
    {
      "type": "info",
      "title": "📖 What is Sandhi?",
      "content": "Sandhi means 'joining'. When two words come together, their sounds combine. This makes Sanskrit flow beautifully!",
      "rules": [
        {
          "name": "Similar Vowels",
          "description": "When two similar vowels meet, they become a long vowel.",
          "examples": [
            {"before": "अ + अ", "after": "आ", "example": "नर + अधिपः → नराधिपः (king of men)"},
            {"before": "इ + इ", "after": "ई", "example": "मुनि + ईशः → मुनीशः (lord of sages)"},
            {"before": "उ + उ", "after": "ऊ", "example": "गुरु + उक्तिः → गुरूक्तिः (teacher's saying)"}
          ]
        },
        {
          "name": "Different Vowels",
          "description": "Different vowels combine in specific ways.",
          "examples": [
            {"before": "अ + इ", "after": "ए", "example": "नर + इन्द्रः → नरेन्द्रः (king of men)"},
            {"before": "अ + उ", "after": "ओ", "example": "गङ्गा + उदकम् → गङ्गोदकम् (Ganges water)"},
            {"before": "अ + ऋ", "after": "अर्", "example": "महा + ऋषिः → महर्षिः (great sage)"}
          ]
        },
        {
          "name": "Visarga Sandhi",
          "description": "How words ending in 'ः' (visarga) change.",
          "examples": [
            {"before": "रामः + गच्छति", "after": "रामो गच्छति", "meaning": "Rama goes"},
            {"before": "रामः + अस्ति", "after": "रामोऽस्ति", "meaning": "Rama is"}
          ]
        }
      ]
    },
    {
      "type": "quiz",
      "title": "🎯 Vowel Sandhi Quiz",
      "questions": [
        {
          "id": 1,
          "question": "What happens when 'अ + अ' meet?",
          "options": ["अ", "आ", "ए", "ओ"],
          "correct": 1,
          "explanation": "'अ + अ' becomes 'आ'."
        },
        {
          "id": 2,
          "question": "What does 'अ + इ' become?",
          "options": ["आ", "इ", "ए", "ओ"],
          "correct": 2,
          "explanation": "'अ + इ' becomes 'ए'."
        },
        {
          "id": 3,
          "question": "What is the correct sandhi: 'रामः + अस्ति'?",
          "options": ["रामः अस्ति", "रामास्ति", "रामोऽस्ति", "रामःस्ति"],
          "correct": 2,
          "explanation": "'रामः + अस्ति' → 'रामोऽस्ति'."
        }
      ]
    }
  ]
}