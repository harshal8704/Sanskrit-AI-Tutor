{
  "id": "day22_sandhi_consonant",
  "title": "🔊 Consonant Sandhi (व्यञ्जनसन्धिः)",
  "description": "Learn how consonants combine when words meet.",
  "level": "intermediate",
  "module": "grammar",
  "difficulty": 4,
  "prerequisites": ["day21_sandhi_vowel"],
  "estimated_time": 30,
  "sections": [
    {
      "type": "info",
      "title": "📖 Consonant Sandhi Rules",
      "content": "When consonants meet, they often change to make pronunciation easier.",
      "rules": [
        {
          "name": "Similar Sounds",
          "description": "When two consonants from the same group meet, they merge.",
          "examples": [
            {"before": "क् + त", "after": "क्त", "example": "वाक् + त्वम् → वाक्त्वम् (speech-ness)"},
            {"before": "द् + ग", "after": "द्ग", "example": "भवत् + गिरिः → भवद्गिरिः (your mountain)"}
          ]
        },
        {
          "name": "Special Combinations",
          "description": "Some consonants combine in special ways.",
          "examples": [
            {"before": "त् + श", "after": "च्छ", "example": "उत् + श्वासः → उच्छ्वासः (breath out)"},
            {"before": "द् + भ", "after": "द्भ", "example": "जगत् + भवति → जगद्भवति (world becomes)"},
            {"before": "न् + च", "after": "ञ्च", "example": "सन् + च → सञ्च (with)"}
          ]
        },
        {
          "name": "Visarga + Consonant",
          "description": "How words ending in 'ः' change before consonants.",
          "examples": [
            {"before": "रामः + करोति", "after": "रामः करोति", "meaning": "Rama does"},
            {"before": "रामः + पश्यति", "after": "रामः पश्यति", "meaning": "Rama sees"}
          ]
        }
      ]
    },
    {
      "type": "quiz",
      "title": "🎯 Consonant Sandhi Quiz",
      "questions": [
        {
          "id": 1,
          "question": "What happens when 'त् + श' meet?",
          "options": ["त्श", "च्छ", "त्च", "च"],
          "correct": 1,
          "explanation": "'त् + श' becomes 'च्छ'."
        },
        {
          "id": 2,
          "question": "What is the correct sandhi: 'उत् + श्वासः'?",
          "options": ["उत्श्वासः", "उच्छ्वासः", "उतश्वासः", "उश्वासः"],
          "correct": 1,
          "explanation": "'उत् + श्वासः' → 'उच्छ्वासः'."
        }
      ]
    }
  ]
}