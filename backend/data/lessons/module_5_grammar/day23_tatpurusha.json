{
  "id": "day23_tatpurusha",
  "title": "📖 Compound Words - Tatpurusha (तत्पुरुष समासः)",
  "description": "Learn to form and understand Tatpurusha compounds.",
  "level": "intermediate",
  "module": "grammar",
  "difficulty": 4,
  "prerequisites": ["day22_sandhi_consonant"],
  "estimated_time": 30,
  "sections": [
    {
      "type": "info",
      "title": "📖 What is Tatpurusha?",
      "content": "Tatpurusha means 'his servant'. It's a compound where the first word depends on the second (like an adjective-noun relationship).",
      "rules": [
        {
          "name": "Karmadharaya (Adjective + Noun)",
          "example": "महा + राजः → महाराजः (great king)",
          "meaning": "An adjective + noun compound"
        },
        {
          "name": "Dvigu (Number + Noun)",
          "example": "त्रि + भुवनम् → त्रिभुवनम् (three worlds)",
          "meaning": "A number + noun compound"
        },
        {
          "name": "Tatpurusha (Case Relation)",
          "example": "राज + पुत्रः → राजपुत्रः (son of the king)",
          "meaning": "First word is in a case relation to the second"
        }
      ],
      "examples": [
        {"compound": "राजपुत्रः", "breakdown": "राज्ञः पुत्रः (son of the king)"},
        {"compound": "गृहस्वामी", "breakdown": "गृहस्य स्वामी (master of the house)"},
        {"compound": "देवालयः", "breakdown": "देवस्य आलयः (house of the gods - temple)"}
      ]
    },
    {
      "type": "quiz",
      "title": "🎯 Tatpurusha Quiz",
      "questions": [
        {
          "id": 1,
          "question": "What does 'राजपुत्रः' mean?",
          "options": ["King's son", "Son of a king", "Prince", "All of the above"],
          "correct": 3,
          "explanation": "'राजपुत्रः' means 'son of the king' = prince."
        },
        {
          "id": 2,
          "question": "What is the compound for 'master of the house'?",
          "options": ["राजपुत्रः", "गृहस्वामी", "देवालयः", "महाराजः"],
          "correct": 1,
          "explanation": "'गृहस्वामी' = गृहस्य स्वामी (master of the house)."
        }
      ]
    }
  ]
}