      "type": "info",
      "title": "📖 Future Tense (लृट्)",
      "content": "The future tense is used for actions that will happen in the future.",
      "conjugation": {
        "verb_root": "गम् (gam) - to go",
        "forms": {
          "अहम्": "गमिष्यामि (gamiṣyāmi) - I will go",
          "त्वम्": "गमिष्यसि (gamiṣyasi) - You will go",
          "सः/सा/तत्": "गमिष्यति (gamiṣyati) - He/She/It will go"
        },
        "examples": {
          "अहम्": "अहं विद्यालयं गमिष्यामि। (I will go to school.)",
          "त्वम्": "त्वं गृहं गमिष्यसि। (You will go home.)",
          "सः": "सः वनं गमिष्यति। (He will go to the forest.)"
        }
      },
      "other_verbs": {
        "पठ् (paṭh) - to read": {
          "अहम्": "पठिष्यामि (paṭhiṣyāmi) - I will read",
          "त्वम्": "पठिष्यसि (paṭhiṣyasi) - You will read",
          "सः": "पठिष्यति (paṭhiṣyati) - He will read"
        }
      }
    },
    {
      "type": "quiz",
      "title": "🎯 Future Tense Quiz",
      "questions": [
        {
          "id": 1,
          "question": "How do you say 'I will go' in Sanskrit?",
          "options": ["गच्छामि", "अगच्छम्", "गमिष्यामि", "जगाम"],
          "correct": 2,
          "explanation": "'गमिष्यामि' (gamiṣyāmi) is the future tense."
        },
        {
          "id": 2,
          "question": "How do you say 'She will read' in Sanskrit?",
          "options": ["पठति", "अपठत्", "पठिष्यति", "पपाठ"],
          "correct": 2,
          "explanation": "'पठिष्यति' (paṭhiṣyati) means 'She will read'."
        }
      ]
    }
  ]
