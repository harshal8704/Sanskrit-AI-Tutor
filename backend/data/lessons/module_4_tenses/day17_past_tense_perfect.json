    {
      "type": "info",
      "title": "📖 Perfect Tense (Past - लिट्)",
      "content": "The perfect tense is used for actions that have been completed in the past. In English, it's like 'has done' or 'had done'.",
      "conjugation": {
        "verb_root": "गम् (gam) - to go",
        "forms": {
          "अहम्": "जगाम (jagāma) - I went/have gone",
          "त्वम्": "जगमिथ (jagamitha) - You went/have gone",
          "सः/सा/तत्": "जगाम (jagāma) - He/She/It went/has gone"
        },
        "examples": {
          "अहम्": "अहं वनं जगाम। (I went to the forest.)",
          "सः": "सः गृहं जगाम। (He went home.)"
        }
      },
      "other_verbs": {
        "पठ् (paṭh) - to read": {
          "अहम्": "पपाठ (papāṭha) - I read",
          "सः": "पपाठ (papāṭha) - He read"
        },
        "दृश् (dṛś) - to see": {
          "अहम्": "ददर्श (dadarśa) - I saw",
          "सः": "ददर्श (dadarśa) - He saw"
        }
      },
      "note": "The perfect tense often repeats the first consonant of the root."
    },
    {
      "type": "quiz",
      "title": "🎯 Perfect Tense Quiz",
      "questions": [
        {
          "id": 1,
          "question": "How do you say 'I have gone' in Sanskrit?",
          "options": ["गच्छामि", "अगच्छम्", "जगाम", "गमिष्यामि"],
          "correct": 2,
          "explanation": "'जगाम' (jagāma) is the perfect tense form."
        },
        {
          "id": 2,
          "question": "How do you say 'He has read' in Sanskrit?",
          "options": ["पठति", "अपठत्", "पपाठ", "पठिष्यति"],
          "correct": 2,
          "explanation": "'पपाठ' (papāṭha) is the perfect tense."
        }
      ]
    }
  ]
