{
  "id": "day3_alphabet_consonants",
  "title": "🔤 Devanagari Consonants (व्यञ्जनानि)",
  "description": "Learn the 33 consonants of Sanskrit grouped by sound.",
  "level": "beginner",
  "module": "foundations",
  "difficulty": 1,
  "prerequisites": ["day2_alphabet_vowels"],
  "estimated_time": 25,
  "sections": [
    {
      "type": "info",
      "title": "📖 Sanskrit Consonants",
      "content": "Sanskrit consonants are grouped by where and how they are pronounced.",
      "groups": [
        {
          "name": "Velar (कवर्ग)",
          "description": "Sounds from the back of the throat",
          "consonants": [
            {"devanagari": "क", "transliteration": "k", "sound": "'k' in 'kite'"},
            {"devanagari": "ख", "transliteration": "kh", "sound": "aspirated 'k'"},
            {"devanagari": "ग", "transliteration": "g", "sound": "'g' in 'go'"},
            {"devanagari": "घ", "transliteration": "gh", "sound": "aspirated 'g'"},
            {"devanagari": "ङ", "transliteration": "ṅ", "sound": "'ng' in 'sing'"}
          ]
        },
        {
          "name": "Palatal (चवर्ग)",
          "description": "Sounds from the roof of the mouth",
          "consonants": [
            {"devanagari": "च", "transliteration": "c", "sound": "'ch' in 'church'"},
            {"devanagari": "छ", "transliteration": "ch", "sound": "aspirated 'ch'"},
            {"devanagari": "ज", "transliteration": "j", "sound": "'j' in 'jug'"},
            {"devanagari": "झ", "transliteration": "jh", "sound": "aspirated 'j'"},
            {"devanagari": "ञ", "transliteration": "ñ", "sound": "'ny' in 'canyon'"}
          ]
        },
        {
          "name": "Retroflex (टवर्ग)",
          "description": "Sounds with tongue curled back",
          "consonants": [
            {"devanagari": "ट", "transliteration": "ṭ", "sound": "'t' in 'top' (curled)"},
            {"devanagari": "ठ", "transliteration": "ṭh", "sound": "aspirated 'ṭ'"},
            {"devanagari": "ड", "transliteration": "ḍ", "sound": "'d' in 'dog' (curled)"},
            {"devanagari": "ढ", "transliteration": "ḍh", "sound": "aspirated 'ḍ'"},
            {"devanagari": "ण", "transliteration": "ṇ", "sound": "'n' in 'no' (curled)"}
          ]
        },
        {
          "name": "Dental (तवर्ग)",
          "description": "Sounds with tongue against teeth",
          "consonants": [
            {"devanagari": "त", "transliteration": "t", "sound": "'t' in 'hotel'"},
            {"devanagari": "थ", "transliteration": "th", "sound": "'th' in 'thumb'"},
            {"devanagari": "द", "transliteration": "d", "sound": "'d' in 'dog'"},
            {"devanagari": "ध", "transliteration": "dh", "sound": "'dh' in 'dharma'"},
            {"devanagari": "न", "transliteration": "n", "sound": "'n' in 'no'"}
          ]
        },
        {
          "name": "Labial (पवर्ग)",
          "description": "Sounds with lips",
          "consonants": [
            {"devanagari": "प", "transliteration": "p", "sound": "'p' in 'pot'"},
            {"devanagari": "फ", "transliteration": "ph", "sound": "aspirated 'p'"},
            {"devanagari": "ब", "transliteration": "b", "sound": "'b' in 'bat'"},
            {"devanagari": "भ", "transliteration": "bh", "sound": "aspirated 'b'"},
            {"devanagari": "म", "transliteration": "m", "sound": "'m' in 'mat'"}
          ]
        },
        {
          "name": "Semi-vowels & Sibilants",
          "description": "Other important sounds",
          "consonants": [
            {"devanagari": "य", "transliteration": "y", "sound": "'y' in 'yes'"},
            {"devanagari": "र", "transliteration": "r", "sound": "'r' in 'run'"},
            {"devanagari": "ल", "transliteration": "l", "sound": "'l' in 'love'"},
            {"devanagari": "व", "transliteration": "v", "sound": "'v' in 'love'"},
            {"devanagari": "श", "transliteration": "ś", "sound": "'sh' in 'ship'"},
            {"devanagari": "ष", "transliteration": "ṣ", "sound": "'sh' (retroflex)"},
            {"devanagari": "स", "transliteration": "s", "sound": "'s' in 'sun'"},
            {"devanagari": "ह", "transliteration": "h", "sound": "'h' in 'hat'"}
          ]
        }
      ]
    },
    {
      "type": "quiz",
      "title": "🎯 Consonant Recognition Quiz",
      "instructions": "Choose the correct Devanagari consonant.",
      "questions": [
        {
          "id": 1,
          "question": "Which consonant represents the sound 'k'?",
          "options": ["ग", "च", "क", "त"],
          "correct": 2,
          "explanation": "'क' (ka) is the 'k' sound."
        },
        {
          "id": 2,
          "question": "Which group does 'म' (ma) belong to?",
          "options": ["Velar", "Palatal", "Dental", "Labial"],
          "correct": 3,
          "explanation": "'म' (ma) is a labial sound, made with the lips."
        },
        {
          "id": 3,
          "question": "How do you write the 'sh' sound as in 'ship'?",
          "options": ["ष", "श", "स", "ह"],
          "correct": 1,
          "explanation": "'श' (śa) is the palatal 'sh' sound."
        }
      ]
    }
  ]
}