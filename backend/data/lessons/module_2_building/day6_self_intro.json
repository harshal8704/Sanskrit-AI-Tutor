  "sections": [
    {
      "type": "info",
      "title": "📖 Introducing Yourself",
      "content": "Here are the essential phrases to introduce yourself in Sanskrit:",
      "phrases": [
        {
          "sanskrit": "मम नाम [Name] अस्ति।",
          "transliteration": "Mama nāma [Name] asti.",
          "meaning": "My name is [Name].",
          "example": "मम नाम रामः अस्ति। (My name is Rama.)"
        },
        {
          "sanskrit": "अहं [City] नगरे वसामि।",
          "transliteration": "Ahaṃ [City] nagare vasāmi.",
          "meaning": "I live in the city of [City].",
          "example": "अहं दिल्ली नगरे वसामि। (I live in Delhi.)"
        },
        {
          "sanskrit": "अहं [Profession] अस्मि।",
          "transliteration": "Ahaṃ [Profession] asmi.",
          "meaning": "I am a [Profession].",
          "example": "अहं छात्रः अस्मि। (I am a student.)"
        },
        {
          "sanskrit": "मम आयुः [Age] वर्षाणि अस्ति।",
          "transliteration": "Mama āyuḥ [Age] varṣāṇi asti.",
          "meaning": "I am [Age] years old.",
          "example": "मम आयुः पञ्चविंशति वर्षाणि अस्ति। (I am 25 years old.)"
        }
      ],
      "professions": [
        {"english": "Student (M)", "sanskrit": "छात्रः", "transliteration": "Chātraḥ"},
        {"english": "Student (F)", "sanskrit": "छात्रा", "transliteration": "Chātrā"},
        {"english": "Teacher (M)", "sanskrit": "शिक्षकः", "transliteration": "Śikṣakaḥ"},
        {"english": "Teacher (F)", "sanskrit": "शिक्षिका", "transliteration": "Śikṣikā"},
        {"english": "Engineer (M)", "sanskrit": "अभियन्ता", "transliteration": "Abhiyantā"},
        {"english": "Doctor (M)", "sanskrit": "वैद्यः", "transliteration": "Vaidyaḥ"}
      ]
    },
