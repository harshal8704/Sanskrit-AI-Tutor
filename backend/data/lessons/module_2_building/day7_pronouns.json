{
  "id": "day7_pronouns",
  "title": "👤 Basic Sanskrit Pronouns",
  "description": "Learn the essential pronouns: I, You, He, She, It.",
  "level": "beginner",
  "module": "building",
  "difficulty": 2,
  "prerequisites": ["day6_self_intro"],
  "estimated_time": 20,
  "sections": [
    {
      "type": "info",
      "title": "📖 Essential Pronouns",
      "content": "Pronouns are the building blocks of sentences. Master these first!",
      "pronouns": [
        {
          "person": "First Person Singular",
          "sanskrit": "अहम्",
          "transliteration": "Aham",
          "meaning": "I",
          "example": "अहं पठामि। (I read.)"
        },
        {
          "person": "Second Person Singular",
          "sanskrit": "त्वम्",
          "transliteration": "Tvam",
          "meaning": "You",
          "example": "त्वं पठसि। (You read.)"
        },
        {
          "person": "Third Person Masculine",
          "sanskrit": "सः",
          "transliteration": "Saḥ",
          "meaning": "He / That (masculine)",
          "example": "सः पठति। (He reads.)"
        },
        {
          "person": "Third Person Feminine",
          "sanskrit": "सा",
          "transliteration": "Sā",
          "meaning": "She / That (feminine)",
          "example": "सा पठति। (She reads.)"
        },
        {
          "person": "Third Person Neuter",
          "sanskrit": "तत्",
          "transliteration": "Tat",
          "meaning": "It / That (neuter)",
          "example": "तत् अस्ति। (It is.)"
        }
      ],
      "note": "Notice how the verb changes with each pronoun. We'll learn this in the next lesson!"
    },
    {
      "type": "quiz",
      "title": "🎯 Pronoun Quiz",
      "instructions": "Choose the correct pronoun.",
      "questions": [
        {
          "id": 1,
          "english": "I",
          "options": ["त्वम्", "सः", "अहम्", "सा"],
          "correct": 2,
          "explanation": "'अहम्' (Aham) means 'I'."
        },
        {
          "id": 2,
          "english": "He",
          "options": ["सः", "सा", "त्वम्", "तत्"],
          "correct": 0,
          "explanation": "'सः' (Saḥ) means 'He'."
        },
        {
          "id": 3,
          "english": "She",
          "options": ["सः", "सा", "त्वम्", "अहम्"],
          "correct": 1,
          "explanation": "'सा' (Sā) means 'She'."
        }
      ]
    }
  ]
}