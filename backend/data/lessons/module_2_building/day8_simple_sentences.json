  "sections": [
    {
      "type": "info",
      "title": "📖 Building Simple Sentences",
      "content": "Sanskrit follows a Subject-Object-Verb (SOV) word order. Here are the basics:",
      "patterns": [
        {
          "pattern": "Subject + Verb",
          "example": "अहं पठामि।",
          "translation": "I read.",
          "breakdown": "अहम् (I) + पठामि (read)"
        },
        {
          "pattern": "Subject + Object + Verb",
          "example": "अहं पुस्तकं पठामि।",
          "translation": "I read a book.",
          "breakdown": "अहम् (I) + पुस्तकम् (book) + पठामि (read)"
        }
      ],
      "key_verbs": [
        {"sanskrit": "पठामि", "transliteration": "paṭhāmi", "meaning": "I read"},
        {"sanskrit": "पठसि", "transliteration": "paṭhasi", "meaning": "You read"},
        {"sanskrit": "पठति", "transliteration": "paṭhati", "meaning": "He/She/It reads"},
        {"sanskrit": "गच्छामि", "transliteration": "gacchāmi", "meaning": "I go"},
        {"sanskrit": "गच्छसि", "transliteration": "gacchasi", "meaning": "You go"},
        {"sanskrit": "गच्छति", "transliteration": "gacchati", "meaning": "He/She/It goes"}
      ]
    },
    {
      "type": "quiz",
      "title": "🎯 Simple Sentences Quiz",
      "instructions": "Choose the correct translation.",
      "questions": [
        {
          "id": 1,
