{
  "id": "day9_present_tense_part1",
  "title": "📚 Present Tense Verbs (Part 1)",
  "description": "Learn the most common present tense verbs: go, read, eat, drink.",
  "level": "beginner",
  "module": "building",
  "difficulty": 2,
  "prerequisites": ["day8_simple_sentences"],
  "estimated_time": 25,
  "sections": [
    {
      "type": "info",
      "title": "📖 Present Tense (Lat Lakara)",
      "content": "These are the most frequently used verbs in Sanskrit. Learn them first!",
      "verbs": [
        {
          "root": "गम् (gam)",
          "meaning": "to go",
          "conjugations": {
            "अहम्": "गच्छामि (gacchāmi)",
            "त्वम्": "गच्छसि (gacchasi)",
            "सः/सा/तत्": "गच्छति (gacchati)"
          },
          "example": "अहं विद्यालयं गच्छामि। (I go to school.)"
        },
        {
          "root": "पठ् (paṭh)",
          "meaning": "to read",
          "conjugations": {
            "अहम्": "पठामि (paṭhāmi)",
            "त्वम्": "पठसि (paṭhasi)",
            "सः/सा/तत्": "पठति (paṭhati)"
          },
          "example": "सः पुस्तकं पठति। (He reads a book.)"
        },
        {
          "root": "खाद् (khād)",
          "meaning": "to eat",
          "conjugations": {
            "अहम्": "खादामि (khādāmi)",
            "त्वम्": "खादसि (khādasi)",
            "सः/सा/तत्": "खादति (khādati)"
          },
          "example": "बालकः फलं खादति। (The boy eats fruit.)"
        },
        {
          "root": "पा (pā)",
          "meaning": "to drink",
          "conjugations": {
            "अहम्": "पिबामि (pibāmi)",
            "त्वम्": "पिबसि (pibasi)",
            "सः/सा/तत्": "पिबति (pibati)"
          },
          "example": "सा जलं पिबति। (She drinks water.)"
        }
      ]
    },
    {
      "type": "quiz",
      "title": "🎯 Verb Conjugation Quiz",
      "instructions": "Choose the correct verb form.",
      "questions": [
        {
          "id": 1,
          "question": "How do you say 'I go'?",
          "options": ["गच्छसि", "गच्छामि", "गच्छति", "गच्छन्ति"],
          "correct": 1,
          "explanation": "'गच्छामि' (gacchāmi) means 'I go'."
        },
        {
          "id": 2,
          "question": "How do you say 'He reads'?",
          "options": ["पठामि", "पठसि", "पठति", "पठन्ति"],
          "correct": 2,
          "explanation": "'पठति' (paṭhati) means 'He reads'."
        },
        {
          "id": 3,
          "question": "How do you say 'You eat'?",
          "options": ["खादामि", "खादसि", "खादति", "खादन्ति"],
          "correct": 1,
          "explanation": "'खादसि' (khādasi) means 'You eat'."
        }
      ]
    }
  ]
}