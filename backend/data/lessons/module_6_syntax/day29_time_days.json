          "id": 1,
          "question": "What does 'सोमवासरः' mean?",
          "options": ["Monday", "Tuesday", "Wednesday", "Thursday"],
          "correct": 0,
          "explanation": "'सोमवासरः' (Somavāsaraḥ) means 'Monday'."
        },
        {
          "id": 2,
          "question": "How do you say 'Today' in Sanskrit?",
          "options": ["अद्य", "श्वः", "ह्यः", "सदा"],
          "correct": 0,
          "explanation": "'अद्य' (Adya) means 'Today'."
        },
        {
          "id": 3,
          "question": "What does 'सार्ध-द्विवादनम्' mean?",
