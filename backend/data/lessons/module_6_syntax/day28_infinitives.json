{
  "id": "day28_infinitives",
  "title": "📖 Infinitives (तुम्)",
  "description": "Learn to use infinitives to express purpose or intention.",
  "level": "intermediate",
  "module": "syntax",
  "difficulty": 4,
  "prerequisites": ["day27_gerunds"],
  "estimated_time": 25,
  "sections": [
    {
      "type": "info",
      "title": "📖 What are Infinitives?",
      "content": "Infinitives express an action that is the purpose or goal of another action. In English, they use 'to + verb'.",
      "formation": {
        "rule": "Add 'तुम्' (tum) to the verb root.",
        "examples": [
          {
            "verb": "पठ् (paṭh) - to read",
            "infinitive": "पठितुम् (paṭhitum)",
            "meaning": "to read",
            "sentence": "पठितुम् इच्छति। (He wants to read.)"
          },
          {
            "verb": "गम् (gam) - to go",
            "infinitive": "गन्तुम् (gantum)",
            "meaning": "to go",
            "sentence": "गन्तुम् गच्छति। (He goes to go.)"
          },
          {
            "verb": "दृश् (dṛś) - to see",
            "infinitive": "द्रष्टुम् (draṣṭum)",
            "meaning": "to see",
            "sentence": "द्रष्टुम् इच्छामि। (I want to see.)"
          },
          {
            "verb": "खाद् (khād) - to eat",
            "infinitive": "खादितुम् (khāditum)",
            "meaning": "to eat",
            "sentence": "खादितुम् इच्छति। (He wants to eat.)"
          }
        ]
      },
      "common_uses": [
        {
          "use": "With 'इच्छति' (wants)",
          "example": "सः पठितुम् इच्छति। (He wants to read.)"
        },
        {
          "use": "With 'शक्नोति' (can/is able)",
          "example": "अहं गन्तुम् शक्नोमि। (I can go.)"
        },
        {
          "use": "With 'गच्छति' (goes) for purpose",
          "example": "पठितुं विद्यालयं गच्छति। (He goes to school to read.)"
        }
      ]
    },
    {
      "type": "quiz",
      "title": "🎯 Infinitives Quiz",
      "questions": [
        {
          "id": 1,
          "question": "What is the infinitive of 'पठ्' (to read)?",
          "options": ["पठितुम्", "पठ", "पठति", "पठित्वा"],
          "correct": 0,
          "explanation": "'पठितुम्' (paṭhitum) means 'to read'."
        },
        {
          "id": 2,
          "question": "What does 'गन्तुम्' mean?",
          "options": ["going", "to go", "went", "having gone"],
          "correct": 1,
          "explanation": "'गन्तुम्' (gantum) means 'to go'."
        },
        {
          "id": 3,
          "question": "Translate: 'सः पठितुम् इच्छति।'",
          "options": [
            "He reads.",
            "He wants to read.",
            "He has read.",
            "He will read."
          ],
          "correct": 1,
          "explanation": "'सः पठितुम् इच्छति।' means 'He wants to read.'"
        }
      ]
    }
  ]
}