          "options": ["going", "having gone", "to go", "goes"],
          "correct": 1,
          "explanation": "'गत्वा' (gatvā) means 'having gone'."
        },
        {
          "id": 3,
          "question": "Translate: 'पठित्वा गच्छति।'",
          "options": [
            "He goes to read.",
            "Having read, he goes.",
            "He reads and goes.",
            "He will read and go."
          ],
          "correct": 1,
          "explanation": "'पठित्वा गच्छति।' means 'Having read, he goes.'"
        }
      ]
    }
  ]
