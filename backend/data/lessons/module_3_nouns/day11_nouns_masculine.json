{
  "id": "day11_nouns_masculine",
  "title": "📖 Noun Declensions (Masculine)",
  "description": "Learn how masculine nouns change form based on their role in the sentence.",
  "level": "beginner",
  "module": "nouns",
  "difficulty": 2,
  "prerequisites": ["day10_present_tense_part2"],
  "estimated_time": 30,
  "sections": [
    {
      "type": "info",
      "title": "📖 What are Declensions?",
      "content": "In Sanskrit, nouns change their ending based on their function in the sentence. This is called 'declension' (vibhakti).",
      "cases": [
        {
          "case": "Nominative (Prathama)",
          "function": "Subject of the sentence",
          "ending": "ः (visarga)",
          "example": "रामः (Rama - as subject)"
        },
        {
          "case": "Accusative (Dvitiya)",
          "function": "Direct Object",
          "ending": "म्",
          "example": "रामम् (Rama - as object)"
        },
        {
          "case": "Instrumental (Tritiya)",
          "function": "With/by",
          "ending": "ेन",
          "example": "रामेण (With/by Rama)"
        },
        {
          "case": "Dative (Chaturthi)",
          "function": "For/to",
          "ending": "ाय",
          "example": "रामाय (For/to Rama)"
        },
        {
          "case": "Ablative (Panchami)",
          "function": "From",
          "ending": "ात्",
          "example": "रामात् (From Rama)"
        },
        {
          "case": "Genitive (Shashthi)",
          "function": "Possessive (of)",
          "ending": "स्य",
          "example": "रामस्य (Rama's / of Rama)"
        },
        {
          "case": "Locative (Saptami)",
          "function": "In/on/at",
          "ending": "े",
          "example": "रामे (In/on Rama)"
        },
        {
          "case": "Vocative (Sambodhana)",
          "function": "Calling/Addressing",
          "ending": " (विसर्ग)",
          "example": "हे राम (Hey Rama!)"
        }
      ],
      "full_declension": {
        "noun": "राम (Rāma)",
        "meaning": "Rama",
        "singular": {
          "nominative": "रामः",
          "accusative": "रामम्",
          "instrumental": "रामेण",
          "dative": "रामाय",
          "ablative": "रामात्",
          "genitive": "रामस्य",
          "locative": "रामे",
          "vocative": "हे राम"
        }
      }
    },
    {
      "type": "quiz",
      "title": "🎯 Masculine Noun Quiz",
      "instructions": "Choose the correct case form.",
      "questions": [
        {
          "id": 1,
          "question": "What is the accusative form of 'राम' (Rama)?",
          "options": ["रामः", "रामम्", "रामेण", "रामाय"],
          "correct": 1,
          "explanation": "'रामम्' is the accusative form (direct object)."
        },
        {
          "id": 2,
          "question": "How do you say 'Rama's book' (of Rama)?",
          "options": ["रामः पुस्तकम्", "रामस्य पुस्तकम्", "रामम् पुस्तकम्", "रामेण पुस्तकम्"],
          "correct": 1,
          "explanation": "'रामस्य' is the genitive case (possessive)."
        },
        {
          "id": 3,
          "question": "How do you say 'to Rama'?",
          "options": ["रामम्", "रामाय", "रामेण", "रामात्"],
          "correct": 1,
          "explanation": "'रामाय' is the dative case (to/for)."
        }
      ]
    }
  ]
}