# Application Settings
SECRET_KEY=your-secret-key-here
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_USERNAME=admin
